__pycache__/
*.py[cod]
.cache/

# The library holds the user's own CSVs; keep the directory, not its contents.
library/*
!library/.gitkeep

# Downloaded gallery images.
images/*
!images/.gitkeep

# Folder assignments per UI Preset, written from the Preset folders tab.
preset_folders.json

# The API key and the folder the last Civitai fetch used.
last_used.json
